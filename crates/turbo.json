{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "lint": {
      "dependsOn": [],
      "inputs": [
        "*/src/**",
        "*/tests/**",
        "*/Cargo.toml",
        "*/build.rs",
        "*/package.json",
        "*/turbo.json",
        "package.json",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/deny.toml"
      ],
      "outputs": []
    },
    "coverage": {
      "dependsOn": [],
      "inputs": [
        "*/src/**",
        "*/tests/**",
        "*/Cargo.toml",
        "*/build.rs",
        "package.json",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock"
      ],
      "outputs": ["lcov.info"]
    },
    "build:release": {
      "dependsOn": [],
      "cache": false
    }
  }
}
