{
  "name": "pathway",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "A native, pathlib-inspired filesystem API for TypeScript, Bun, Node and Rust",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*",
    "apps/*",
    "benches/*",
    "crates",
    "crates/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:release": "turbo run build:release",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "coverage": "turbo run coverage",
    "lint": "turbo run lint lint:biome lint:actions",
    "fmt": "turbo run fmt fmt:biome",
    "dev": "turbo run dev",
    "bench": "turbo run bench",
    "lint:biome": "biome check .",
    "lint:actions": "actionlint",
    "fmt:biome": "biome format --write .",
    "lint:rust": "turbo run lint --filter=@repo/rust --filter=@repo/rust-core --filter=@repo/rust-path --filter=@repo/rust-engine",
    "build:native": "turbo run build:native --filter=@archont561/pathway",
    "build:native:release": "turbo run build:native:release --filter=@archont561/pathway",
    "docs:build": "turbo run build --filter=pathway-docs",
    "docs:check": "turbo run typecheck --filter=pathway-docs",
    "docs:dev": "turbo run dev --filter=pathway-docs",
    "docs:preview": "turbo run preview --filter=pathway-docs",
    "test:rust": "turbo run test --filter=@repo/rust-core --filter=@repo/rust-path --filter=@repo/rust-engine",
    "test:affected": "turbo run test --affected",
    "lint:affected": "turbo run lint lint:biome lint:actions --affected"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.3.11",
    "backlog.md": "^1.53.0",
    "skills": "^1.7.0",
    "turbo": "^2.11.5",
    "typescript": "^5.9.0"
  }
}
