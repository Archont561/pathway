{
  "name": "pathway",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "A native, pathlib-inspired filesystem API for TypeScript, Bun, Node and Rust",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*",
    "benches/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "bench": "turbo run bench",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.3.11",
    "backlog.md": "^1.53.0",
    "skills": "^1.7.0",
    "turbo": "^2.11.5",
    "typescript": "^5.9.0"
  }
}
