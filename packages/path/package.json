{
  "name": "@myorg/path",
  "version": "0.1.0",
  "description": "A native, pathlib-inspired filesystem API for TypeScript, Bun and Node",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.11",
  "sideEffects": false,
  "files": [
    "dist",
    "index.js",
    "index.d.ts",
    "myorg-path.*.node"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0"
  }
}
