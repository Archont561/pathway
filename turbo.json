{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["biome.json", "pixi.toml"],
  "globalEnv": ["PATHWAY_VERSION"],
  "tasks": {
    "build:native": {
      "dependsOn": [],
      "inputs": [
        "package.json",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/crates/**"
      ],
      "outputs": ["*.node", "native-engine.d.ts"]
    },
    "build": {
      "dependsOn": ["^build", "build:native"],
      "inputs": [
        "src/**",
        "package.json",
        "tsconfig.json",
        "tsconfig.build.json",
        "$TURBO_ROOT$/packages/typescript-config/**"
      ],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "package.json", "tsconfig.json"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "package.json",
        "tsconfig.json",
        "tsconfig.build.json",
        "$TURBO_ROOT$/packages/typescript-config/**"
      ],
      "outputs": []
    },
    "bench": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "fixtures/**", "package.json", "tsconfig.json"],
      "outputs": ["results/**"]
    }
  }
}
